{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "git-pull-diagnose",
			"type": "shell",
			"command": "git",
			"args": [
				"pull",
				"--no-rebase",
				"origin",
				"main"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "git-merge-unrelated",
			"type": "shell",
			"command": "git",
			"args": [
				"pull",
				"--no-rebase",
				"--allow-unrelated-histories",
				"origin",
				"main"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "git-push-after-merge",
			"type": "shell",
			"command": "git",
			"args": [
				"push",
				"origin",
				"main"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "git-final-status",
			"type": "shell",
			"command": "git",
			"args": [
				"status",
				"--short",
				"--branch"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		}
	]
}